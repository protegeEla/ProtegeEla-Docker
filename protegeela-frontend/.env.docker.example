# Copy this file to .env in this folder and fill in your values.
DB_PASSWORD=luiz

# SMTP settings. Example: Gmail with an App Password.
# Email verification is disabled by default; enable only after SMTP is configured.
EMAIL_VERIFICATION_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@example.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM=your-address@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
